# ==============================================================================
# learn_ontology101-book 프로젝트 환경변수 예시 파일 (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 서울시 열린데이터광장 OpenAPI 설정
# ------------------------------------------------------------------------------
# OpenAPI 인증키 (강남역 실시간 인구 및 도시데이터 수집용)
S_API_KEY=your_seoul_openapi_key_here
SEOUL_API_KEY=your_seoul_openapi_key_here

# ------------------------------------------------------------------------------
# 2. 로컬 LLM (Ollama) 설정
# ------------------------------------------------------------------------------
# Docker 컨테이너 환경의 Ollama 서비스 주소
OLLAMA_BASE_URL=http://graphrag_agent_ai_ollama:11434
OLLAMA_HOST=http://graphrag_agent_ai_ollama:11434
# 사용할 기본 LLM 모델명
OLLAMA_MODEL=qwen3

# ------------------------------------------------------------------------------
# 3. Apache Jena Fuseki 서버 설정
# ------------------------------------------------------------------------------
FUSEKI_HOME=/opt/fuseki
FUSEKI_BASE=/opt/fuseki/run
FUSEKI_PORT=3030
FUSEKI_URL=http://localhost:3030

# ------------------------------------------------------------------------------
# 4. SPARQL 엔드포인트 및 Named Graph 설정
# ------------------------------------------------------------------------------
DATASET=fc
SPARQL_ENDPOINT=http://localhost:3030/fc/query
SPARQL_UPDATE_ENDPOINT=http://localhost:3030/fc/update
GRAPH_STORE_ENDPOINT=http://localhost:3030/fc/data
GRAPH_IRI=http://k.fc/onto
GANGNAM_GRAPH_IRI=http://k.gangnam/onto
